{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:dev": "node --env-file=.env scripts/dev-db.mjs",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build:types": "tsc --noEmit",
    "prisma": "node --env-file=.env ./node_modules/prisma/build/index.js",
    "studio": "node --env-file=.env ./node_modules/prisma/build/index.js studio --port 5555 --browser none",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env ./node_modules/vitest/vitest.mjs",
    "seed": "tsx --env-file=.env scripts/seed.ts --si",
    "db:vaciar": "tsx --env-file=.env scripts/seed.ts --si --vacio",
    "ver": "tsx --env-file=.env scripts/ver.ts",
    "postinstall": "node ./node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
