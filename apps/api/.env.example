# Copia este archivo a ".env" y cambia los valores. NUNCA subas ".env" al repositorio.

# Base de datos. En Docker Compose será el servicio "db"; en desarrollo, el PostgreSQL local (npm run db:dev).
DATABASE_URL="postgresql://postgres:CAMBIAME@localhost:54329/nivel"

# Secreto para firmar los tokens de sesión (JWT). Mínimo 32 caracteres, aleatorio y distinto en cada instalación.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIAME-por-un-valor-aleatorio-de-al-menos-32-caracteres"

PORT=3001
# Copias de seguridad automáticas (una cada 24 h, se conservan las últimas 30). COPIAS_EXTRA_DIR es OPCIONAL pero muy
# recomendada: una segunda carpeta en OTRO disco o una USB (si el PC se daña, la copia del mismo disco se pierde con él).
COPIAS_DIR="./copias"
# COPIAS_EXTRA_DIR="E:/respaldos-nivel"

# Personalización del cliente (logo y paleta). Copia «personalizacion.ejemplo» como «personalizacion» y edítala.
# PERSONALIZACION_DIR="./personalizacion"

# Carpeta de fotos de productos (respáldala junto con la base de datos).
UPLOADS_DIR="./uploads"
# Origen permitido del front en desarrollo (en producción nginx sirve front y API desde el mismo origen).
CORS_ORIGIN="http://localhost:5183"

# Solo para cargar datos de prueba en desarrollo (npm run seed). Pon claves tuyas.
SEED_DUENO_USUARIO="juan"
SEED_DUENO_CLAVE="CAMBIAME-clave-del-dueno"
SEED_VENDEDOR_USUARIO="maria"
SEED_VENDEDOR_CLAVE="CAMBIAME-clave-del-vendedor"

# ── Reporte semanal por correo (OPCIONAL) ──
# Cada 7 días se envía un Excel con las ventas y el inventario, y la copia de seguridad adjunta.
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" (NO uses tu clave normal).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tucorreo@gmail.com"
# SMTP_PASS="contraseña-de-aplicacion"
# REPORTE_PARA="dueno@correo.com,otro@correo.com"
# REPORTE_ADJUNTAR_COPIA=true
